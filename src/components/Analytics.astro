<script is:inline>
  window.goatcounter = { allow_local: true };
</script>
<script
  is:inline
  data-goatcounter="https://yahiaabusaif.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"
></script>
<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest('a[href]');
    if (!link || !window.goatcounter || typeof window.goatcounter.count !== 'function') {
      return;
    }
    let url;
    try {
      url = new URL(link.href, location.href);
    } catch {
      return;
    }
    if (url.origin === location.origin) return;
    window.goatcounter.count({
      path: 'click-' + url.href,
      title: (link.textContent || url.href).trim(),
      event: true,
    });
  });
</script>
