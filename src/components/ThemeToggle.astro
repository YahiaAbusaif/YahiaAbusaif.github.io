<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M18.9 5.1l-1.6 1.6M6.7 17.3l-1.6 1.6"
    ></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"
      d="M15.5 3.2a8.2 8.2 0 1 0 5.3 12.6A7 7 0 0 1 15.5 3.2z"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;

  function isDark() {
    return root.classList.contains('dark');
  }

  function syncLabel(button: HTMLButtonElement) {
    button.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
  }

  function apply(next: 'dark' | 'light') {
    root.classList.toggle('dark', next === 'dark');
    localStorage.setItem('theme', next);
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncLabel);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    syncLabel(button);
    button.addEventListener('click', () => {
      apply(isDark() ? 'light' : 'dark');
    });
  });
</script>
