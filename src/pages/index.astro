---
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 6);
---

<Base
  title="Yahia Ali Abusaif — Software Engineer"
  description="Senior software engineer. I take a product from the design through the build, on work that started from nothing and on systems already at scale."
  current="home"
>
  <section class="masthead">
    <div class="plate-frame">
      <svg class="plate-ring" viewBox="0 0 200 200" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.35">
          <rect x="30" y="30" width="140" height="140" />
          <rect x="30" y="30" width="140" height="140" transform="rotate(45 100 100)" />
        </g>
      </svg>
      <img class="plate" src="/profile.png" alt="Portrait of Yahia Abusaif" width="160" height="160" />
    </div>
    <div class="masthead-copy">
      <h1>
        <span class="name-line">Yahia</span>
        <span class="name-line name-last"> Abusaif</span>
      </h1>
      <p class="role">Senior Software Engineer</p>
      <div class="mark" aria-hidden="true"></div>
      <p class="lede">
        I take a product from the design through the build, on the backend and the
        infrastructure, and then I look at what shipped. I have done that on a multi-tenant
        product built from nothing, and on systems that were already running at scale.
      </p>
    </div>
    <div class="contact">
      <button type="button" class="contact-button" data-place-open>Give me a visit</button>
      <a class="contact-button" href="mailto:yahiaali2014.ya@gmail.com">Send me an email</a>
      <a
        class="contact-button"
        href="mailto:yahiaali2014.ya@gmail.com?subject=Phone%20number&body=Hello%20Yahia%2C%0A%0AI%20would%20like%20your%20phone%20number.%0A"
      >Give me a call</a>
      <a class="contact-button" href="https://linkedin.com/in/yahiaabusaif" target="_blank" rel="noreferrer">Connect on LinkedIn</a>
      <a class="contact-button" href="https://github.com/YahiaAbusaif" target="_blank" rel="noreferrer">Checkout my GitHub</a>
      <a class="contact-button" href="https://heylink.me/yahiaali2014.ya/" target="_blank" rel="noreferrer">Learn more</a>
    </div>
    <dialog class="place-dialog" id="place-dialog">
      <svg class="place-mark" viewBox="0 0 168 96" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M8 82 H160" />
          <path d="M22 82 L68 24 L114 82" />
          <path d="M92 82 L122 46 L152 82" />
          <path d="M68 24 L74 34 L62 34 Z" />
        </g>
      </svg>
      <p class="place-name">Egypt</p>
      <p class="place-where">New Cairo</p>
      <button type="button" class="contact-button" data-place-close>Close</button>
    </dialog>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <div class="section-head">
      <h2 id="writing-heading">Latest essays</h2>
      <a href="/blog/">All essays</a>
    </div>
    <Contents posts={latest} />
  </section>

  <section class="section cv" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Technical profile</h2>
    <ul class="skill-list">
      <li><strong>Languages & frameworks:</strong> C# (.NET Core), Dart (Flutter), Python (Django), React, SQL</li>
      <li><strong>Cloud & infrastructure:</strong> AWS (CDK, SQS, EventBridge, Lambda), Azure, Docker, CI/CD</li>
      <li>
        <strong>Data & AI engineering:</strong> PostgreSQL, MS SQL, Entity Framework (EF), DynamoDB, Cosmos DB,
        Redis, Azure Data Factory, ETL pipelines, LLM integration
      </li>
      <li>
        <strong>Systems architecture:</strong> Domain-Driven Design, event-driven, multi-tenant SaaS,
        system migration, idempotency patterns
      </li>
      <li><strong>Observability & security:</strong> Grafana, New Relic, design docs, ADRs, RFCs</li>
    </ul>
  </section>

  <section class="section cv" id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Professional experience</h2>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">Present</span>
        <span class="job-rule"></span>
        <span class="job-start">Nov 2025</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Senior Software Engineer</span>
          <span class="job-company">Qualiphi (Cairo, Egypt)</span>
        </h3>
        <p class="visually-hidden">Nov 2025 – Present</p>
        <ul>
          <li>
            <strong>Platform from nothing:</strong> Built the platform from nothing with the
            business and design teams, in C#, .NET Core, Python, Django, and React. Chose the
            architecture after comparing frameworks and cloud providers, stood up AWS with CDK,
            and defined how the team ships, from the design document through a ticket to production.
          </li>
          <li>
            <strong>Identity:</strong> Owned the platform's identity end to end, on the frontend,
            backend, and infrastructure: authentication, sessions, invitations, Google and
            Microsoft sign-in, and multi-tenant RBAC.
          </li>
          <li>
            <strong>Product:</strong> Designed and shipped content management, one-to-one career
            sessions, and the student profile, including claims, vector embeddings, AI generation,
            and anti-web-scraping.
          </li>
          <li>
            <strong>Legacy product:</strong> Mentored the junior engineers on a legacy product of
            more than 10 per-tenant branches and brought it to a state they could manage. The
            older product and the new platform together support 40k+ users across
            multiple tenants.
          </li>
        </ul>
      </div>
    </article>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">Present</span>
        <span class="job-note">part-time</span>
        <span class="job-rule"></span>
        <span class="job-start">Jul 2025</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Software Engineer</span>
          <span class="job-company">LDUN (Remote, KSA)</span>
        </h3>
        <p class="visually-hidden">Jul 2025 – Present · part-time</p>
        <ul>
          <li>Fixed findings from a pentest and raised the security bar, with new layers for reset password, OTP, login, and the checks around them.</li>
          <li>
            Enhanced order file management, payment plans, order reporting, validations, and
            supplier setup. Introduced retry logic in the notification engine, plus notifications
            and alerts. Also reviewed other engineers' code.
          </li>
        </ul>
      </div>
    </article>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">July 2025</span>
        <span class="job-rule"></span>
        <span class="job-start">May 2024</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Software Engineer</span>
          <span class="job-company">Microsoft (Cairo, Egypt)</span>
        </h3>
        <p class="visually-hidden">May 2024 – July 2025</p>
        <ul>
          <li>
            <strong>Distributed systems optimization:</strong> Architected a centralized
            orchestration layer to replace a legacy "pull-and-discard" model where 500k+
            domain payloads were redundantly processed by downstream services, resulting in
            a 90% reduction in unnecessary data I/O and eliminating massive cloud compute waste.
          </li>
          <li>
            <strong>Cross-org leadership & SLA definition:</strong> Investigated and overhauled
            a failing operational SLA by defining a mathematical priority-tiering system for
            a 500k+ domain ecosystem. Drove cross-organizational alignment across multiple
            teams to adopt the new priority streams, reducing P0/P1 domain processing time
            from 3-5 days to under 6 hours, and boosting the editorial team's throughput by
            600% (from 11 to 80+ domains/week).
          </li>
          <li>
            <strong>Data engineering for AI:</strong> Built the automated data ingestion and
            feature-generation pipelines to power a new LLM-based domain classification model.
            Integrated cross-org data feeds and web scraping tools to continuously feed the
            model, diverting traffic from manual review.
          </li>
          <li>
            <strong>Real-time observability:</strong> Transformed operational visibility by
            migrating a rigid, batch-processed daily dashboard to an intuitive, near real-time
            (hourly) analytics platform. Leveraged Kusto (KQL), Cosmos DB, Scope (Data Lake),
            and Power BI to accelerate cross-team decision-making and SLA tracking.
          </li>
        </ul>
      </div>
    </article>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">May 2024</span>
        <span class="job-rule"></span>
        <span class="job-start">Dec 2021</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Senior Software Engineer / Software Engineer II / Software Engineer I</span>
          <span class="job-company">Sahl (Giza, Egypt)</span>
        </h3>
        <p class="visually-hidden">Dec 2021 – May 2024</p>
        <ul>
          <li>
            <strong>System scale-up:</strong> Engineered backend and mobile systems to support
            a 40x transaction volume growth, scaling from 2.5k to 100k daily transactions,
            also 16% conversion lift from performance and UX.
          </li>
          <li>
            <strong>Release management & stability:</strong> Owned the mobile app release
            lifecycle. Enforced a strict Feature-Flag deployment strategy, eliminating
            sprint-killing hot-fixes and enabling risk-free rollouts, and data-driven A/B testing.
          </li>
          <li>
            <strong>Fintech integrations:</strong> Spearheaded complex integrations with major
            telecoms (Vodafone, Orange) and various SMBs, navigating unreliable third-party
            documents and APIs.
          </li>
          <li>
            <strong>Notification microservice:</strong> Architected a decoupled C# .NET/AWS SQS
            microservice to process millions of push and in-app notifications, supporting
            advanced capabilities like batch sending, scheduling, and in-app deep linking.
          </li>
          <li>
            <strong>Observability & analytics:</strong> Built a custom Flutter event-orchestration
            layer to unify mobile analytics (Mixpanel, GA, FBA), bridging the gap between
            engineering and business by training PMs and Marketing on data-driven decision-making.
          </li>
          <li>
            <strong>Team leadership:</strong> Acted as a core technical leader alongside the L8
            Director, sharing responsibilities for driving sprint planning, managing OKR
            alignment, handling cross-functional syncs, and conducting technical
            interviews/onboarding.
          </li>
        </ul>
      </div>
    </article>
  </section>

  <section class="section cv" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">2020</span>
        <span class="job-rule"></span>
        <span class="job-start">2015</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Cairo University</span>
          <span class="job-company">Bachelor’s in Computer Engineering</span>
        </h3>
        <p class="visually-hidden">2015 – 2020</p>
      </div>
    </article>

    <article class="job job-year">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">2021</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Udacity</span>
          <span class="job-company">Nanodegree in Data Analysis</span>
        </h3>
        <p class="visually-hidden">2021</p>
      </div>
    </article>
  </section>

  <section class="section cv" aria-labelledby="extra-heading">
    <h2 id="extra-heading">Extracurricular</h2>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">2019</span>
        <span class="job-rule"></span>
        <span class="job-start">2016</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">ACM ICPC Training</span>
        </h3>
        <p class="visually-hidden">2016–2019</p>
        <p class="job-blurb">
          Ranked 37th out of 165 in ACM ECPC 2018, advanced to ACPC finals (C++).
        </p>
      </div>
    </article>

    <article class="job">
      <div class="job-rail" aria-hidden="true">
        <span class="job-end">2015</span>
        <span class="job-rule"></span>
        <span class="job-start">2009</span>
      </div>
      <div class="job-main">
        <h3>
          <span class="job-role">Teacher at Dumah Al-Jandal Charitable Org</span>
        </h3>
        <p class="visually-hidden">2009–2015</p>
        <p class="job-blurb">Led weekly 8-hour sessions for ~30 students.</p>
      </div>
    </article>
  </section>

  <section class="section cv" aria-labelledby="recs-heading">
    <h2 id="recs-heading">Recommendations</h2>
    <p>
      Available on
      <a href="https://linkedin.com/in/yahiaabusaif/details/recommendations" target="_blank" rel="noreferrer">LinkedIn</a>
      — including a Microsoft engineering manager and Sahl / Microsoft teammates.
    </p>
  </section>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#place-dialog');
  const open = document.querySelector<HTMLButtonElement>('[data-place-open]');

  open?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-place-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
