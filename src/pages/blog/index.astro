---
import Base from '../../layouts/Base.astro';
import Contents from '../../components/Contents.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base
  title="Essays — Yahia Ali Abusaif"
  description="Software engineering notes, written down before the code."
  current="blog"
>
  <header class="chapter">
    <div>
      <h1>Essays</h1>
      <p class="byline">Notes on engineering, process, and the work around the code.</p>
    </div>
  </header>
  <Contents posts={posts} showExcerpt />
</Base>
